# Copy to .env before running locally. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

MYSQL_DATABASE=harumission
MYSQL_USER=harumission
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
